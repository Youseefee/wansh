<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded Wenshy LaunchTheme: deep slate (#0F172A) with amber emblem -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/wenshy_deep_slate</item>
        <item name="android:navigationBarColor">@color/wenshy_deep_slate</item>
    </style>
    <!-- NormalTheme applied after Flutter renders its first frame -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

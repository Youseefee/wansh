# ============================================================================
# Wenshy (ونشي) Monorepo — Root .gitignore
# ============================================================================

# OS & Editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# Environment & Secrets (keep *.example templates)
.env
.env.*
!.env.example

# Android / iOS Signing & Local Properties (keep *.example templates)
key.properties
!key.properties.example
local.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Flutter & Dart
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
**/build/
coverage/
*.g.dart.tmp

# Node / Vite / React (`apps/admin_web`)
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Supabase local CLI temp state
supabase/.temp/
supabase/.branches/

# Logs
*.log
